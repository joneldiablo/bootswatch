extends ./file.pug
include ../mixins/page.pug

block vars 
  - 
    emisorRazon = '{{emisor_razon}}';
    emisorRegimen = '{{emisor_regimen}}';
    emisorRfc = '{{emisor_rfc}}';
    facturaFecha = '{{factura_fecha}}';
    facturaFechaTimbrado = '{{factura_fecha_timbrado}}';
    facturaFolio = '{{factura_folio}}';
    facturaLuExp = '{{factura_lu_exp}}';
    facturaMoneda = '{{factura_moneda}}';
    facturaPagina = '{{factura_pagina}}';
    facturaPaginasTotal = '{{factura_paginas_total}}';
    facturaTipo = '{{factura_tipo}}';
    facturaUuid = '{{factura_uuid}}';
    faturaTotal = '{{fatura_total}}';
    filas = [
      {
        filaDescripcion: '{{fila_descripcion}}',
        filaCantidad: '{{fila_cantidad}}',
        filaValorUnitario: '{{fila_valor_unitario}}',
        filaImporte: '{{fila_importe}}',
      },
      {
        filaDescripcion: '{{fila_descripcion}}',
        filaCantidad: '{{fila_cantidad}}',
        filaValorUnitario: '{{fila_valor_unitario}}',
        filaImporte: '{{fila_importe}}',
      }
    ];
    receptorDomicilio = '{{receptor_domicilio}}';
    receptorRazon = '{{receptor_razon}}';
    receptorRegimen = '{{receptor_regimen}}';
    receptorRfc = '{{receptor_rfc}}';
    receptorUsoCfdi = '{{receptor_uso_cfdi}}';
    timbreRfc = '{{timbre_rfc}}';

block content 
  +page('custom')
    div(style="width:100%; height:30px;")
    table.mb-4
      tr
        td(style="width: 35%;")
          .small-bolder.mb-2.text-primary.text-uppercase / Folio
          .px-2
            h2= facturaFolio
            table 
              tr
                th Fecha
                td :
                td= facturaFecha
              tr 
                th Tipo de Comprobante
                td :
                td= facturaTipo
              tr 
                th Lugar de Expedición
                td :
                td= facturaLuExp
        td(style="width: 10%;")
        td(style="width: 55%;")
          h1.text-end.text-primary.m-0.text-uppercase
            span.text-nowrap Comprobante Fiscal
            br
            span.text-nowrap Digital por Internet
            br
            span CFDI
    table.align-top.mb-5
      tr
        td(style="width: 30%;")
          .small-bolder.mb-2.text-primary.text-uppercase / Emisor
          .px-2
            h3= emisorRazon
            table 
              tr
                th RFC
                td :
                td= emisorRfc
              tr 
                th Régimen Fiscal
                td :
                td= emisorRegimen
        td(style="width: 20%;")
        td(style="width: 30%;") 
          .small-bolder.mb-2.text-primary.text-uppercase / Receptor
          .px-2
            h3= receptorRazon
            table 
              tr
                th RFC
                td :
                td= receptorRfc
              tr 
                th Régimen Fiscal
                td :
                td= receptorRegimen
              tr 
                th Domicilio Fiscal
                td :
                td= receptorDomicilio
              tr 
                th Uso CFDI 
                td :
                td= receptorUsoCfdi
        td(style="width: 5%;")

    table.table.table-striped.mb-4.table-description
      thead 
        tr.text-uppercase 
          th.gray-1.position-relative
            img.bg-ht(src="./bg-gray-1.png")
            span.position-absolute.center Descripción
          th.gray-2.position-relative
            img.bg-ht(src="./bg-gray-2.png")
            span.position-absolute.center Cantidad
          th.gray-3.position-relative 
            img.bg-ht(src="./bg-gray-3.png")
            span.position-absolute.center Valor Unitario
          th.gray-4.position-relative
            img.bg-ht(src="./bg-gray-4.png")
            span.position-absolute.center Importe
      tbody 
        each row in filas
          tr 
            td.text-uppercase= row.filaDescripcion
            td.text-end= row.filaCantidad
            td.text-end= row.filaValorUnitario
            td.text-end= row.filaImporte
    table
      tr
        td(style="width:30%")
        td(style="width:30%")
        td
          .ms-auto
            table.mb-2 
              tr 
                td: h3 Total
                td(style="width: 40%")
                td.text-center.text-bg-primary.py-1.px-4.display-5.position-relative(style="height:22px;min-width:95px;")
                  img.bg-ht(src="./bg-primary.png")
                  span.position-absolute.center= faturaTotal
            table
              tr 
                td(style="width: 50%"): h4 Moneda
                td(style="width: 12%").text-end :
                td(style="width: 38%")= facturaMoneda

    table
      tr
        td.align-middle(style="width: 40%")
          .small-bolder.mb-2.text-primary.text-uppercase / Timbre Fiscal Digital
          .px-2
            h3= receptorRazon
            table 
              tr
                th(style="width: 40%") UUID
                td(style="width: 4%") :
                td(style="width: 56%")= facturaUuid
              tr
                th Fecha Timbrado
                td :
                td= facturaFechaTimbrado
              tr.align-bottom
                th RFC Proveedor Certificado
                td :
                td= timbreRfc
        td(style="width: 60%")
    .pagination    
      span.text-uppercase Pag&nbsp;&nbsp;
      span.pag-actual= facturaPagina
      | &nbsp;|&nbsp;
      span.pag-total= facturaPaginasTotal
    img.header-img(src="./header.png")
    img.footer-img(src="./bottom.png")
