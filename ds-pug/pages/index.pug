                          script(type='application/javascript').
                            (() => document.addEventListener('DOMContentLoaded', () => {
                            function togglePanelMenu(evt) {
                            const img = this.parentNode.querySelector('#logoImgEXAMPLE');
                            const iconNode = this.querySelector('i');
                            let imgSrc = img.src;
                            let dislplayText;
                            let isOpen = localStorage.getItem('panelIsOpen');
                            isOpen = isOpen ? JSON.parse(isOpen) : false;
                            isOpen = evt === 'init' ? !isOpen : isOpen;
                            if (isOpen) {
                            imgSrc = '/_assets/img/logo-short.svg';
                            dislplayText = 'none';
                            iconNode.classList.replace('cpa-icon-circle-left', 'cpa-icon-circle-right');
                            this.parentNode.classList.remove('open');
                            } else {
                            imgSrc = '/_assets/img/logo-full.svg';
                            dislplayText = null;
                            icon = 'cpa-icon-circle-right';
                            iconNode.classList.replace('cpa-icon-circle-right', 'cpa-icon-circle-left');
                            this.parentNode.classList.add('open');
                            }
                            img.src = imgSrc;
                            const textButtons = document.getElementsByClassName('text-menu-EXAMPLE');
                            for (const element of textButtons) {
                            element.style.display = dislplayText;
                            }
                            if (evt !== 'init')
                            localStorage.setItem('panelIsOpen', JSON.stringify(!isOpen));
                            this.parentNode.style.display = null;
                            }
                            const btnToggleMenu = document.querySelector('.toggle-panel-EXAMPLE');
                            btnToggleMenu.addEventListener('click', togglePanelMenu);
                            togglePanelMenu.bind(btnToggleMenu)('init');
